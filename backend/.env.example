# backend/.env.example — copia a backend/.env y rellena lo que uses.
# En producción estos valores se ponen en las variables de entorno de Coolify,
# NUNCA en el Dockerfile ni en docker-compose.yml (está en git).

# ── General ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
# Dominio(s) del frontend para CORS (coma-separado). NO usar "*" en producción.
FRONTEND_ORIGIN=https://rayvermusic.com
# URL pública del sitio (se usa en los links de checkout de Stripe).
SITE_URL=https://rayvermusic.com
# Carpeta de datos (db.json + db.json.bak). En Docker: /app/data (volumen Coolify).
# DATA_DIR=./data

# ── Auth (OBLIGATORIO en producción) ─────────────────────────────────────────
# Firma los tokens HMAC de admin y de usuario. Si falta, el backend genera uno
# aleatorio EN CADA ARRANQUE → todos los tokens se invalidan al reiniciar.
# Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
# Contraseña del panel de admin. Si se define, se aplica al arrancar (permite
# resetearla desde Coolify sin perder datos). En una DB nueva sin este valor se
# genera una aleatoria y se imprime una vez en el log.
ADMIN_PASSWORD=

# ── Pagos (Stripe) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# true = mostrar planes Ambiente (precios) en la web pública
SHOW_PUBLIC_AMBIENT_PLANS=false
# Secreto del endpoint del webhook (Stripe Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ── Spotify Web API (Client Credentials, sin login de usuario) ───────────────
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# IDs de artista de Spotify separados por coma (opcional).
SPOTIFY_ARTIST_IDS=

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
# https://console.cloud.google.com → habilita "YouTube Data API v3" → clave API
YOUTUBE_API_KEY=
# IDs de canal (UC...) separados por coma.
YOUTUBE_CHANNEL_IDS=

# ── SoundCloud (motor de radio) ──────────────────────────────────────────────
SC_CLIENT_ID=
SC_CLIENT_SECRET=
# SC_CLIENT_ID_PUBLIC=        # id que se expone al cliente (si difiere)
# SC_USER=  SC_USER_PERMALINK=  SC_PLAYLIST_URL=

# ── IA ───────────────────────────────────────────────────────────────────────
# Claude API — asistente de letras (/api/admin/generate/lyrics)
ANTHROPIC_API_KEY=
# Suno vía goapi.ai — música por prompt (/api/admin/generate/music)
GOAPI_KEY=
# Google API — import de carpetas de Google Drive para música ambiente
GOOGLE_API_KEY=

# ── Generación de música propia (self-hosted en GPU) ─────────────────────────
# Servidores de gpu-server/ (ACE-Step / YuE). Vacío = deshabilitado.
ACE_STEP_URL=
YUE_URL=
# Rutas locales a escanear para import de audio ambient (coma-separado).
# AMBIENT_SCAN_PATHS=

# ── Email (avisos de caducidad de suscripción) ──────────────────────────────
# Gmail con "Contraseña de aplicación" (2FA activado).
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=RAYVER Music <tu_email@gmail.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EXPIRY_WARNING_DAYS=7

# ── Recuperación de la DB ────────────────────────────────────────────────────
# JSON completo de db.json en base64: si no existe el fichero al arrancar, se
# restaura desde aquí. Útil para recuperar producción sin depender del volumen.
# DB_INIT=
